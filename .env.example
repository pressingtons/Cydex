# Optional: enables actual welcome-email delivery through Resend.
# Create an API key and verify a sender domain at https://resend.com.
RESEND_API_KEY=re_your_key_here
RESEND_FROM="Cydex <welcome@your-domain.com>"

# Keep these server-side. The current checkout UI remains disabled until a
# PayPal Orders API integration is completed and verified in sandbox first.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
